# Copy this file to a new file named .env (keep the dot). Everything is optional.
PORT=3000
# 127.0.0.1 = only this computer (use this behind a tunnel or Caddy). 0.0.0.0 = reachable on your network.
HOST=0.0.0.0
# Set to 1 ONLY when a trusted HTTPS proxy sits in front (Caddy, Cloudflare Tunnel, Render, Fly, Railway).
TRUST_PROXY=0
# This explorer name gets the "Summon event" button. Leave empty for nobody.
ADMIN_NAME=Alice
# Where users.json and market.json are saved. Point at a persistent disk when hosting.
# DATA_DIR=/data
MAX_USERS=500
